pragma solidity ^0.8.37;

import {IVaultVerifier} from "../engine/IVaultVerifier.sol";

/// @notice Minimal SP1 on-chain verifier interface (v6 layout):
///         verify(proof, keccak256(publicValues)) — reverts on invalid proof,
///         returns nothing on success.
interface ISP1Verifier {
    function verify(bytes memory proof, bytes32 publicValuesDigest) external view;
}

/// @title ZKVerifier — zero-disclosure verification path for standhaft vaults
/// @notice Verifies an SP1 Groth16-wrapped proof produced by `standhaft-host`:
///         the guest program ran ML-DSA-44 verification INSIDE the zkVM and
///         committed `commitment = keccak256(public_key)` and `msgHash`.
///         With this verifier, NEITHER the signature NOR the public key ever
///         touches the chain — zero harvest-now-decrypt-later footprint.
///
/// Proof parameter layout (from standhaft-host):
///   [ SP1 proof bytes (4-byte vkey-hash prefix + encoded proof) ]
///   [ public values (72B): commitment(32) || msgHash(32) || system(8) ]
///
/// Soundness binding (three independent checks):
///  1. proof[0:4] must equal `vkPrefix` — only proofs generated by OUR guest
///     program pass (blocks substituting a fake guest that skips verification).
///  2. public values content must match the vault's (commitment, msgHash) —
///     binds the proof to THIS vault and THIS action.
///  3. SP1Verifier must accept the proof for digest keccak256(publicValues).
///
/// NOTE: `vkPrefix` is derived from the guest program's verifying key at
/// deployment time (host prints it) — treat it as a protocol constant.
contract ZKVerifier is IVaultVerifier {

    error ProofTooShort();
    error UntrustedProgram(bytes4 actualPrefix, bytes4 expectedPrefix);
    error BadPublicValues();

    /// @notice SP1 verifier or verifier gateway for our SP1 version.
    address public immutable sp1Verifier;
    /// @notice First 4 bytes of the guest vkey hash — pins OUR program.
    bytes4 public immutable vkPrefix;
    uint256 public constant PV_LEN = 72; // commitment(32) || msgHash(32) || system(8)
    uint256 public constant MIN_PROOF_LEN = 4 + PV_LEN;

    constructor(address sp1Verifier_, bytes4 vkPrefix_) {
        sp1Verifier = sp1Verifier_;
        vkPrefix = vkPrefix_;
    }

    function verify(bytes32 commitment, bytes32 messageHash, bytes calldata proof)
        external
        view
        override
        returns (bool valid)
    {
        if (proof.length < MIN_PROOF_LEN) return false;

        // 1. program pinning (audit: fake-guest substitution guard)
        bytes4 actualPrefix = bytes4(proof[:4]);
        if (actualPrefix != vkPrefix) revert UntrustedProgram(actualPrefix, vkPrefix);

        // 2. public values content binding
        bytes calldata pv = proof[proof.length - PV_LEN:];
        if (bytes32(pv[:32]) != commitment) return false;
        if (bytes32(pv[32:64]) != messageHash) return false;

        // 3. SP1 proof verification against digest over the FULL public values
        bytes calldata sp1Proof = proof[:proof.length - PV_LEN];
        bytes32 digest = keccak256(pv);
        try ISP1Verifier(sp1Verifier).verify(sp1Proof, digest) {
            valid = true;
        } catch {
            valid = false;
        }
    }

    function scheme() external pure returns (string memory) {
        return "zk-ml-dsa-44/sp1-groth16";
    }
}
