pragma solidity ^0.8.37;

import {IVaultVerifier} from "../engine/IVaultVerifier.sol";

/// @notice Minimal SP1 on-chain verifier interface (v6 layout):
///         verify(proof, keccak256(publicValues)) — reverts on invalid proof,
///         returns nothing on success.
interface ISP1Verifier {
    function verify(bytes memory proof, bytes32 publicValuesDigest) external view;
}

/// @title ZKVerifier — zero-disclosure verification path for standhaft vaults
/// @notice Verifies an SP1 Groth16-wrapped proof produced by `standhaft-host`:
///         the guest program ran ML-DSA-44 verification INSIDE the zkVM and
///         committed `commitment = keccak256(public_key)` and `msgHash`.
///         With this verifier, NEITHER the signature NOR the public key ever
///         touches the chain — zero harvest-now-decrypt-later footprint.
///
/// Soundness binding (two independent checks):
///  1. The proof's embedded program-vkey digest must equal `vkeyDigest` —
///     only proofs generated by OUR guest program pass (an attacker cannot
///     substitute a fake guest that skips signature verification).
///  2. SP1Verifier must accept the proof for digest =
///     keccak256(commitment || messageHash) — binding the proof to THIS vault
///     and THIS action.
///
/// NOTE: VK_DIGEST_OFFSET is finalized empirically from the first real
/// Groth16 proof (see docs/KNOWN_ISSUES.md).
contract ZKVerifier is IVaultVerifier {

    error ProofTooShort();
    error UntrustedProgram(bytes32 actualVkeyDigest, bytes32 expectedVkeyDigest);

    /// @notice Official SP1 verifier contract (groth16) for our SP1 version.
    address public immutable sp1Verifier;
    /// @notice keccak256(guest verifying-key bytes) — pins OUR program.
    bytes32 public immutable vkeyDigest;
    /// @notice Byte offset of the program-vkey digest inside SP1 proof bytes
    ///         (finalized empirically from the first real Groth16 proof).
    uint256 public immutable vkDigestOffset;
    uint256 public constant MIN_PROOF_LEN = 256;

    constructor(address sp1Verifier_, bytes32 vkeyDigest_, uint256 vkDigestOffset_) {
        sp1Verifier = sp1Verifier_;
        vkeyDigest = vkeyDigest_;
        vkDigestOffset = vkDigestOffset_;
    }

    function verify(bytes32 commitment, bytes32 messageHash, bytes calldata proof)
        external
        view
        override
        returns (bool valid)
    {
        if (proof.length < MIN_PROOF_LEN) return false;

        // program-vkey pinning: only proofs from OUR guest pass
        bytes32 actualVkDigest;
        uint256 off = vkDigestOffset;
        assembly ("memory-safe") {
            actualVkDigest := calldataload(add(proof.offset, off))
        }
        if (actualVkDigest != vkeyDigest) revert UntrustedProgram(actualVkDigest, vkeyDigest);

        // binds the proof to this vault and this action
        bytes32 publicValuesDigest = keccak256(abi.encodePacked(commitment, messageHash));

        try ISP1Verifier(sp1Verifier).verify(proof, publicValuesDigest) {
            valid = true;
        } catch {
            valid = false; // SP1 proof invalid — never revert (interface contract)
        }
    }

    function scheme() external pure returns (string memory) {
        return "zk-ml-dsa-44/sp1-groth16";
    }
}
