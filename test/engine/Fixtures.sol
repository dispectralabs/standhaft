pragma solidity ^0.8.37;

/// @notice Cross-language fixture: real ML-DSA-44 signature produced by standhaft-cli
///         (RustCrypto ml-dsa 0.1.1) over MSG. On-chain verification via MLDSAVerifier
///         proves Rust<->Solidity interoperability of the exact FIPS 204 algorithm.
library Fixtures {
    bytes32 constant MSG = 0x1111111111111111111111111111111111111111111111111111111111111111;
    bytes constant PK =
        hex"";
    bytes constant SIG =
        hex"";

    function commitment() internal pure returns (bytes32) {
        return bytes32(hex"1a487f30262f4312856e353ccc11a8f7d6fe18245d3788fc55e8a418fcbe905a");
    }

    function proof() internal pure returns (bytes memory) {
        return abi.encodePacked(PK, SIG);
    }

    function tamperedProof() internal pure returns (bytes memory) {
        bytes memory p = proof();
        p[0] = p[0] ^ 0x01;
        return p;
    }
}
