pragma solidity ^0.8.37;

import {Test, console} from "forge-std/Test.sol";
import {MLDSAVerifier} from "mldsa-solidity/MLDSAVerifier.sol";
import {MldsaVerifier} from "../../src/verifier/MldsaVerifier.sol";
import {Fixtures} from "./Fixtures.sol";

/// @title MldsaFixtureTest — the cross-language crown test.
/// @notice A REAL ML-DSA-44 signature generated by the Rust CLI is verified on-chain
///         by the vendored FIPS 204 Solidity implementation. If this passes, the two
///         independent implementations agree byte-for-byte on the algorithm.
contract MldsaFixtureTest is Test {
    MldsaVerifier internal adapter;

    function setUp() public {
        MLDSAVerifier core = new MLDSAVerifier(address(0)); // stateless full path
        adapter = new MldsaVerifier(core);
    }

    function test_real_rust_signature_verifies_onchain() public view {
        assertTrue(adapter.verify(Fixtures.commitment(), Fixtures.MSG, Fixtures.proof()));
    }

    function test_wrong_message_rejected() public view {
        bytes32 other = Fixtures.MSG ^ bytes32(uint256(1));
        assertFalse(adapter.verify(Fixtures.commitment(), other, Fixtures.proof()));
    }

    function test_wrong_commitment_rejected() public view {
        assertFalse(adapter.verify(bytes32(uint256(0xdead)), Fixtures.MSG, Fixtures.proof()));
    }

    function test_tampered_signature_rejected() public view {
        assertFalse(adapter.verify(Fixtures.commitment(), Fixtures.MSG, Fixtures.tamperedProof()));
    }

    function test_wrong_length_proof_rejected() public view {
        assertFalse(adapter.verify(Fixtures.commitment(), Fixtures.MSG, hex"deadbeef"));
    }

    function test_gas_direct_verification() public {
        uint256 g0 = gasleft();
        bool ok = adapter.verify(Fixtures.commitment(), Fixtures.MSG, Fixtures.proof());
        uint256 used = g0 - gasleft();
        assertTrue(ok);
        console.log("ML-DSA-44 on-chain verify gas (direct path):", used);
    }
}
